  <script>
    const navbar = document.getElementById("navbar");

    let selectedDeliveryMethod = "";

    window.addEventListener("scroll", function () {
      if (window.scrollY > 80) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });

    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      const allDropdowns = document.querySelectorAll(".dropdown-menu-custom");

      allDropdowns.forEach(menu => {
        if (menu.id !== dropdownId) {
          menu.classList.remove("show");
        }
      });

      dropdown.classList.toggle("show");
    }

    function selectDelivery(event, option) {
      event.stopPropagation();

      selectedDeliveryMethod = option;

      document.getElementById("deliveryText").textContent = option;
      document.getElementById("dateTimeText").textContent = "Select ›";

      document.getElementById("dateInput").value = "";
      document.getElementById("timeInput").value = "";
      document.getElementById("deliverySlotInput").value = "";

      if (option === "Delivery") {
        document.getElementById("deliverySlotBox").style.display = "block";
        document.getElementById("meetupTimeBox").style.display = "none";
      } else {
        document.getElementById("deliverySlotBox").style.display = "none";
        document.getElementById("meetupTimeBox").style.display = "block";
      }

      document.getElementById("deliveryDropdown").classList.remove("show");
    }

    function saveDateTime() {
      const date = document.getElementById("dateInput").value;
      const time = document.getElementById("timeInput").value;
      const deliverySlot = document.getElementById("deliverySlotInput").value;

      if (!selectedDeliveryMethod) {
        alert("Please select Delivery Method first.");
        return;
      }

      if (!date) {
        alert("Please select a date.");
        return;
      }

      if (selectedDeliveryMethod === "Delivery") {
        if (!deliverySlot) {
          alert("Please select a delivery time slot.");
          return;
        }

        document.getElementById("dateTimeText").textContent = `${date}, ${deliverySlot}`;
      }

      if (selectedDeliveryMethod === "Meet up") {
        if (!time) {
          alert("Please select a meet up time.");
          return;
        }

        document.getElementById("dateTimeText").textContent = `${date}, ${time}`;
      }

      document.getElementById("dateTimeDropdown").classList.remove("show");
    }

    document.addEventListener("click", function (event) {
      if (!event.target.closest(".nav-box")) {
        document.querySelectorAll(".dropdown-menu-custom").forEach(menu => {
          menu.classList.remove("show");
        });
      }
    });
  </script>

</body>
