<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Home - Product Management</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #faf7f2;
    }

    .navbar-custom {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100px;
      padding: 0 50px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 1000;
      color: white;
      background: transparent;
      transition: 0.3s ease;
    }

    .navbar-custom.scrolled {
      background: #faf7f2;
      color: #222;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .logo {
      font-size: 32px;
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      width: 45px;
      height: 45px;
      background: #d60000;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 45px;
    }

    .nav-links a {
      color: inherit;
      text-decoration: none;
      font-size: 22px;
    }

    .nav-extra {
      display: none;
      height: 100%;
      align-items: center;
    }

    .navbar-custom.scrolled .nav-extra {
      display: flex;
    }

    .nav-box {
      height: 100%;
      width: 260px;
      padding: 18px 30px;
      border-left: 1px solid #e5ded5;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .nav-box small {
      font-size: 15px;
      letter-spacing: 4px;
      color: #777;
      font-weight: bold;
    }

    .nav-box span {
      font-size: 22px;
      margin-top: 6px;
    }

    .cart {
      width: 65px;
      height: 65px;
      margin-left: 25px;
      border: 1px solid #e5ded5;
      background: transparent;
      font-size: 24px;
      border-radius: 6px;
      cursor: pointer;
    }

    .hero {
      min-height: 100vh;
      background:
        linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.8)),
        url("/images/orangebanner.jpg") center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 120px 20px 40px;
    }

    .hero-subtitle {
      color: #d89b22;
      letter-spacing: 10px;
      font-size: 17px;
      margin-bottom: 25px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-style: italic;
      font-size: 76px;
      line-height: 1.05;
      max-width: 1200px;
    }

    .hero-desc {
      font-size: 24px;
      line-height: 1.6;
      max-width: 800px;
      margin: 35px auto;
    }

    .order-btn {
      background: #d60000;
      color: white;
      border: none;
      padding: 20px 55px;
      font-size: 24px;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }

    footer {
      background-color: white;
      padding: 50px 0;
      color: black;
    }

    footer .footer-container {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      text-align: left;
    }

    footer ul {
      list-style: none;
      padding: 0;
      line-height: 1.8;
    }

    footer a {
      color: darkblue;
      text-decoration: none;
    }

    .payment-logo {
      width: 50px;
      margin-right: 10px;
    }

    @media (max-width: 1000px) {
      .nav-extra {
        display: none !important;
      }

      .nav-links {
        gap: 20px;
      }

      .nav-links a {
        font-size: 16px;
      }

      .navbar-custom {
        padding: 0 20px;
      }

      .hero h1 {
        font-size: 44px;
      }

      .hero-desc {
        font-size: 18px;
      }
    }
  </style>
</head>

<body>

  <header id="navbar" class="navbar-custom">
    <div class="logo">
      <div class="logo-icon">炭</div>
      SEAMLES
    </div>

    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/catalog">Shop⌄</a>
      <a href="#">About⌄</a>
      <a href="#">Help & Info⌄</a>
    </nav>

    <div class="nav-extra">
      <div class="nav-box">
        <small>DELIVERY METHOD</small>
        <span>Select ›</span>
      </div>

      <div class="nav-box">
        <small>DATE & TIME</small>
        <span>Select ›</span>
      </div>

      <button class="cart">🛒</button>
    </div>
  </header>

  <section class="hero">
    <div>
      <p class="hero-subtitle">ENJOY UP TO 50% OFF SELECTED ITEMS</p>

      <h1>
        Welcome to SEAMLES<br>
        Shop Your Favourite Products
      </h1>

      <p class="hero-desc">
        Discover selected items, promotions and more from the comfort of your home.
      </p>

      <a href="/catalog" class="order-btn">Shop Now</a>
    </div>
  </section>

  <footer>
    <div class="container footer-container">
      <div>
        <h4>Customer Service</h4>
        <ul>
          <li><a href="#">FAQs</a></li>
          <li><a href="#">Privacy Policy</a></li>
          <li><a href="#">Return Policy</a></li>
          <li><a href="#">Terms of Service</a></li>
        </ul>

        <div style="margin-top: 20px;">
          <img src="https://upload.wikimedia.org/wikipedia/commons/5/5e/Visa_Inc._logo.svg" class="payment-logo" alt="Visa">
          <img src="https://upload.wikimedia.org/wikipedia/commons/a/a4/Mastercard_2019_logo.svg" class="payment-logo" alt="MasterCard">
          <img src="https://logos-world.net/wp-content/uploads/2020/07/PayPal-Logo-2007-700x394.png" class="payment-logo" alt="Paypal">
        </div>
      </div>

      <div>
        <h4>Contact Us</h4>
        <p>Email: <a href="mailto:23010000@myrp.edu.sg">-</a></p>
        <p>Working Hours: -</p>
        <p>Address: -</p>
        <p>Company Name: SEAMLES</p>
      </div>
    </div>
  </footer>


  <script>
    const navbar = document.getElementById("navbar");

    window.addEventListener("scroll", function () {
      if (window.scrollY > 80) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });
  </script>

</body>
</html>