<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Navbar</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #111;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 80px;
      padding: 0 40px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      z-index: 1000;
      color: white;
      background: transparent;
      transition: 0.3s ease;
    }

    .navbar.scrolled {
      background: #faf7f2;
      color: #222;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    .nav-links a {
      text-decoration: none;
      color: inherit;
      font-size: 15px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1;
      white-space: nowrap;
    }

    .dropdown-arrow {
      font-size: 11px;
      line-height: 1;
      display: inline-block;
      transform: translateY(1px);
    }

    .nav-extra {
      display: none;
      height: 100%;
      align-items: center;
      margin-left: 36px;
    }

    .navbar.scrolled .nav-extra {
      display: flex;
    }

    .nav-box {
      height: 100%;
      width: 180px;
      padding: 10px 18px;
      border-left: 1px solid #e5ded5;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .nav-box small {
      font-size: 10px;
      letter-spacing: 1.5px;
      color: #777;
      font-weight: bold;
    }

    .nav-box span {
      font-size: 14px;
      margin-top: 5px;
    }

    .cart {
      width: 45px;
      height: 45px;
      margin-left: 18px;
      border: 1px solid #e5ded5;
      background: transparent;
      font-size: 18px;
      border-radius: 6px;
      cursor: pointer;
    }

    .hero {
      min-height: 100vh;
      background:
        linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.8)),
        url("/images/hero.jpg") center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 100px 20px 40px;
    }

    .hero-subtitle {
      color: #d89b22;
      letter-spacing: 8px;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-style: italic;
      font-size: 64px;
      line-height: 1.08;
      max-width: 1100px;
    }

    .hero-desc {
      font-size: 18px;
      line-height: 1.6;
      max-width: 720px;
      margin: 28px auto;
    }

    .order-btn {
      background: #d60000;
      color: white;
      border: none;
      padding: 15px 36px;
      font-size: 16px;
      border-radius: 5px;
      cursor: pointer;
    }

    .content {
      height: 900px;
      background: #faf7f2;
      padding: 80px;
      font-size: 22px;
      color: #222;
    }

    @media (max-width: 1000px) {
      .navbar {
        height: 70px;
        padding: 0 20px;
        justify-content: center;
      }

      .nav-links {
        gap: 18px;
      }

      .nav-links a {
        font-size: 13px;
        gap: 4px;
      }

      .dropdown-arrow {
        font-size: 9px;
      }

      .nav-extra {
        display: none !important;
      }

      .hero h1 {
        font-size: 42px;
      }

      .hero-desc {
        font-size: 16px;
      }

      .hero-subtitle {
        font-size: 11px;
        letter-spacing: 5px;
      }
    }
  </style>
</head>

<body>

  <header id="navbar" class="navbar">
    <nav class="nav-links">
      <a href="#">Shop <span class="dropdown-arrow"></span></a>
      <a href="#">About <span class="dropdown-arrow"></span></a>
      <a href="#">Happenings <span class="dropdown-arrow"></span></a>
      <a href="#">Help & Info <span class="dropdown-arrow"></span></a>
    </nav>

    <div class="nav-extra">
      <div class="nav-box">
        <small>DELIVERY METHOD</small>
        <span>Select›</span>
      </div>

      <div class="nav-box">
        <small>DATE & TIME</small>
        <span>Select›</span>
      </div>

      <button class="cart">🛒</button>
    </div>
  </header>

  <section class="hero">
    <div>
      <p class="hero-subtitle">ROASTED FRESH FOR HOME FEASTS</p>

      <h1>
        The Crispiest, Juiciest Char<br>
        Siew & Sio Bak You'll Have
      </h1>

      <p class="hero-desc">
        Honey-glazed char siew and crackling sio bak, marinated for 48 hours
        and roasted to perfection, all from the comfort of your own home.
      </p>

      <button class="order-btn">Order now</button>
    </div>
  </section>

  <section class="content">
    Scroll back up to see the navbar change.
  </section>

  <script>
    const navbar = document.getElementById("navbar");

    window.addEventListener("scroll", function () {
      if (window.scrollY > 80) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });
  </script>

</body>
</html>