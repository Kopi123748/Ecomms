<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Navbar</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #111;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 110px;
      padding: 0 50px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 1000;
      color: white;
      background: transparent;
      transition: 0.3s ease;
    }

    .navbar.scrolled {
      background: #faf7f2;
      color: #222;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }

    .logo {
      font-size: 32px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-icon {
      width: 45px;
      height: 45px;
      background: red;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 50px;
    }

    .nav-links a {
      text-decoration: none;
      color: inherit;
      font-size: 24px;
    }

    .nav-extra {
      display: none;
      height: 100%;
      align-items: center;
    }

    .navbar.scrolled .nav-extra {
      display: flex;
    }

    .nav-box {
      height: 100%;
      width: 300px;
      padding: 18px 36px;
      border-left: 1px solid #e5ded5;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .nav-box small {
      font-size: 16px;
      letter-spacing: 4px;
      color: #777;
      font-weight: bold;
    }

    .nav-box span {
      font-size: 24px;
      margin-top: 8px;
    }

    .cart {
      width: 70px;
      height: 70px;
      margin-left: 25px;
      border: 1px solid #e5ded5;
      background: transparent;
      font-size: 26px;
      border-radius: 6px;
      cursor: pointer;
    }

    .hero {
      min-height: 100vh;
      background:
        linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.8)),
        url("/images/hero.jpg") center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 120px 20px 40px;
    }

    .hero-subtitle {
      color: #d89b22;
      letter-spacing: 12px;
      font-size: 18px;
      margin-bottom: 25px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-style: italic;
      font-size: 82px;
      line-height: 1.05;
      max-width: 1300px;
    }

    .hero-desc {
      font-size: 25px;
      line-height: 1.6;
      max-width: 800px;
      margin: 35px auto;
    }

    .order-btn {
      background: #d60000;
      color: white;
      border: none;
      padding: 22px 55px;
      font-size: 24px;
      border-radius: 5px;
      cursor: pointer;
    }

    .content {
      height: 900px;
      background: #faf7f2;
      padding: 80px;
      font-size: 28px;
    }

    @media (max-width: 1000px) {
      .nav-extra {
        display: none !important;
      }

      .nav-links {
        gap: 20px;
      }

      .hero h1 {
        font-size: 48px;
      }

      .navbar {
        padding: 0 25px;
      }
    }
  </style>
</head>

<body>

  <header id="navbar" class="navbar">
    <div class="logo">
      <div class="logo-icon">Seamles</div>
      Seamles
    </div>

    <nav class="nav-links">
      <a href="#">Shop⌄</a>
      <a href="#">About⌄</a>
      <a href="#">Happenings⌄</a>
      <a href="#">Help & Info⌄</a>
    </nav>

    <div class="nav-extra">
      <div class="nav-box">
        <small>DELIVERY METHOD</small>
        <span>Select ›</span>
      </div>

      <div class="nav-box">
        <small>DATE & TIME</small>
        <span>Select ›</span>
      </div>

      <button class="cart">🛒</button>
    </div>
  </header>

  <section class="hero">
    <div>
      <p class="hero-subtitle">ROASTED FRESH FOR HOME FEASTS</p>

      <h1>
        The Crispiest, Juiciest Char<br>
        Siew & Sio Bak You'll Have
      </h1>

      <p class="hero-desc">
        Honey-glazed char siew and crackling sio bak, marinated for 48 hours
        and roasted to perfection, all from the comfort of your own home.
      </p>

      <button class="order-btn">Order now</button>
    </div>
  </section>

  <section class="content">
    Scroll back up to see the navbar change.
  </section>

  <script>
    const navbar = document.getElementById("navbar");

    window.addEventListener("scroll", function () {
      if (window.scrollY > 80) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });
  </script>

</body>
</html>